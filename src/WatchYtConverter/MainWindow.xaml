<Window x:Class="WatchYtConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="watchYTConverter"
        Height="920" Width="1380" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BarBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- youtube.com 그대로. 로그인 세션은 사용자 데이터 폴더에 유지된다. -->
        <wv2:WebView2 x:Name="Web" Grid.Row="0"/>

        <!-- 로딩 안내 (첫 진입 시 흰 화면 방지) -->
        <Border x:Name="LoadingOverlay" Grid.Row="0" Background="{StaticResource BarBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="YouTube 불러오는 중..." FontSize="15"
                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="3" Margin="0,14,0,0"
                             Background="{StaticResource TrackBrush}" Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- 하단 바 -->
        <Border Grid.Row="1" Background="{StaticResource BarBrush}"
                BorderBrush="{StaticResource BarBorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel>

                <!-- 1행: 지금 보는 영상 + 변환 -->
                <Grid Margin="16,12,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="지금 보는 영상" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                               Text="{Binding WatchTitle, TargetNullValue='영상을 열면 여기에 표시됩니다', FallbackValue='영상을 열면 여기에 표시됩니다'}"
                               ToolTip="{Binding WatchUrl}"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ConvertButton}"
                                Content="🎵  MP3 로 변환"
                                Command="{Binding ConvertCurrentCommand}"
                                ToolTip="보고 있는 영상을 백그라운드로 MP3 변환합니다. 영상은 계속 재생됩니다."/>

                        <CheckBox VerticalAlignment="Center" Margin="16,0,0,0"
                                  IsChecked="{Binding InstantConvertEnabled, Mode=TwoWay}"
                                  Foreground="{StaticResource TextMutedBrush}"
                                  Content="썸네일 바로 변환"
                                  ToolTip="켜면 썸네일을 누르는 즉시 변환을 겁니다 (영상 재생 없이)."/>
                    </StackPanel>
                </Grid>

                <!-- 2행: 백그라운드 변환 목록 -->
                <Border Margin="16,10,16,0" CornerRadius="8" Background="#151515"
                        Visibility="{Binding Jobs.Count, Converter={StaticResource CountToVis}}">
                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Jobs}" Margin="8,6,8,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,4,4,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="48" Height="27" CornerRadius="3"
                                                ClipToBounds="True" Background="{StaticResource TrackBrush}"
                                                Margin="0,0,10,0">
                                            <Image Source="{Binding ThumbnailUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                            <Grid Margin="0,3,0,0">
                                                <ProgressBar Height="3" BorderThickness="0"
                                                             Background="{StaticResource TrackBrush}"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             Minimum="0" Maximum="1" Value="{Binding Progress}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="▶"
                                                FontSize="14" Margin="8,0,0,0"
                                                Command="{Binding PlayCommand}"
                                                ToolTip="변환된 MP3 재생"/>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="✕"
                                                FontSize="12" Margin="2,0,0,0"
                                                Command="{Binding DismissCommand}"
                                                ToolTip="취소 / 목록에서 제거"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 3행: 재생 중일 때만 나오는 재생 컨트롤 -->
                <Grid Margin="16,10,16,0" Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding TogglePlayPauseCommand}"
                                Content="{Binding IsPlaying, Converter={StaticResource PlayGlyph}}"
                                ToolTip="재생 / 일시정지"/>
                        <Button Style="{StaticResource IconButton}" Content="⏹"
                                Command="{Binding StopPlaybackCommand}"
                                ToolTip="재생 정지"/>
                    </StackPanel>

                    <Border Grid.Column="1" Width="56" Height="32" Margin="10,0,10,0"
                            CornerRadius="4" ClipToBounds="True" Background="{StaticResource TrackBrush}">
                        <Image Source="{Binding PlayingThumbnailUrl}" Stretch="UniformToFill"/>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PlayingTitle}" TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding PlayingStatus}" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>

                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding PositionText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,0"/>
                        <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource SeekSlider}"
                                Minimum="0" Maximum="{Binding SliderMaximum}"
                                Value="{Binding PositionSeconds, Mode=OneWay}"
                                Thumb.DragStarted="Seek_DragStarted"
                                Thumb.DragCompleted="Seek_DragCompleted"
                                PreviewMouseLeftButtonUp="Seek_Click"/>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="10,0,0,0"/>
                    </Grid>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <TextBlock Text="🔊" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,6,0"/>
                        <Slider Width="88" Style="{StaticResource SeekSlider}" VerticalAlignment="Center"
                                Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- 4행: 저장 폴더 -->
                <Grid Margin="16,10,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="📁  저장 폴더" VerticalAlignment="Center"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,0"/>

                    <TextBlock Grid.Column="1" Text="{Binding OutputFolder}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               ToolTip="{Binding OutputFolder}"/>

                    <Button Grid.Column="2" Content="열기" Command="{Binding OpenFolderCommand}"
                            Style="{StaticResource IconButton}" FontSize="12" Padding="12,4" Margin="10,0,0,0"
                            ToolTip="탐색기로 저장 폴더를 엽니다"/>
                    <Button Grid.Column="3" Content="변경" Command="{Binding ChangeFolderCommand}"
                            Style="{StaticResource IconButton}" FontSize="12" Padding="12,4" Margin="6,0,0,0"
                            ToolTip="MP3 저장 폴더를 바꿉니다"/>
                </Grid>

                <TextBlock Text="{Binding ErrorText}" Margin="16,0,16,10" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource ErrorBrush}" FontSize="12"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
